# Vercel > Project > Settings > Environment Variables 에 아래 이름 그대로 넣습니다.
# 이 파일에는 실제 값을 적지 말고, 실제 값은 Vercel에만 저장하세요.

# Supabase > Project Settings > API(또는 Data API)의 Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys의 secret key(또는 service_role key). 절대 외부에 공유하지 마세요.
SUPABASE_SECRET_KEY=

# 관리자 로그인 토큰 서명용 무작위 문자열(32자 이상)
SESSION_SECRET=

# 관리자 화면 비밀번호(관리자 코드)
ADMIN_PASSWORD=

# 매일 시간표 자동 동기화(Cron) 인증용 무작위 문자열(32자 이상)
CRON_SECRET=

# 컴시간 학교코드(숫자). 비워 두면 컴시간 동기화를 하지 않습니다.
COMCIGAN_SCHOOL_CODE=

# (선택) off로 두면 컴시간 자동 동기화를 끕니다.
COMCIGAN_AUTO_SYNC=

# (선택) 자동 동기화 최소 간격(분). 기본 15
COMCIGAN_SYNC_MINUTES=

# (선택) 안내 문구에 넣을 웹앱 주소. 비우면 Vercel 기본 주소를 씁니다.
APP_URL=

# (선택) true로 두면 점검 화면만 보입니다.
MAINTENANCE_MODE=
MAINTENANCE_MESSAGE=
